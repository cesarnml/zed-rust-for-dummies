---
/**
 * Narration player for the current page.
 *
 * Renders only when `npm run narrate` has produced audio for this page, so the
 * site degrades to plain text rather than showing a dead control.
 *
 * Two modes are being served here, and they pull in opposite directions:
 *
 * - Read-along, to reinforce a first read. That is what the sentence
 *   highlighting and click-to-seek are for — the eye stays on the real
 *   `window.theme(cx)` while the audio says "window dot theme of context".
 * - Eyes off. That is what auto-advance and position memory are for: the
 *   four-hour listen should not need a click per page, and dozing off should
 *   not cost you your place.
 *
 * The audio element is `preload="none"`, so a visitor who never presses play
 * downloads none of the ~90 MB.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
	/** Href of the next page in sidebar order, for auto-advance. */
	next?: string | undefined;
}

const { next } = Astro.props;

// `/rust/ownership/` → `rust/ownership`, matching the key narrate.mjs derives
// from the built file's path.
const key = Astro.url.pathname.replace(/^\/|\/$/g, '') || 'index';

const sidecarPath = path.join(process.cwd(), 'public/audio', `${key}.json`);
const hasAudio = fs.existsSync(sidecarPath);

let duration = 0;
if (hasAudio) {
	try {
		duration = JSON.parse(fs.readFileSync(sidecarPath, 'utf8')).duration ?? 0;
	} catch {
		duration = 0;
	}
}

const minutes = Math.round(duration / 60);
---

{
	hasAudio && (
		<div class="tts not-content" data-tts-player data-key={key} data-next={next ?? ''}>
			<button class="tts-play" type="button" aria-label="Play narration">
				<svg class="tts-icon-play" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M8 5v14l11-7z" />
				</svg>
				<svg class="tts-icon-pause" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M6 5h4v14H6zM14 5h4v14h-4z" />
				</svg>
			</button>

			<div class="tts-body">
				<div
					class="tts-scrub"
					role="slider"
					tabindex="0"
					aria-label="Seek"
					aria-valuemin="0"
					aria-valuemax={Math.round(duration)}
					aria-valuenow="0"
				>
					<div class="tts-track">
						<div class="tts-fill" />
					</div>
				</div>
				<div class="tts-meta">
					<span class="tts-time">
						<span class="tts-elapsed">0:00</span>
						<span class="tts-sep"> / </span>
						<span class="tts-total">{minutes} min</span>
					</span>
					<span class="tts-controls">
						<button class="tts-rate" type="button" aria-label="Playback speed">
							1×
						</button>
						<button class="tts-reset" type="button" aria-label="Reset to start">
							<svg class="tts-icon-reset" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z" />
							</svg>
						</button>
						<label class="tts-chain">
							<input type="checkbox" checked />
							<span>keep playing</span>
						</label>
					</span>
				</div>
			</div>

			<audio class="tts-audio" preload="none" src={`/audio/${key}.mp3`} />

			<div class="tts-mini" aria-hidden="true">
				<button class="tts-mini-play" type="button" aria-label="Play narration">
					<svg class="tts-icon-play" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M8 5v14l11-7z" />
					</svg>
					<svg class="tts-icon-pause" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M6 5h4v14H6zM14 5h4v14h-4z" />
					</svg>
				</button>
				<div
					class="tts-mini-scrub tts-scrub"
					role="slider"
					tabindex="0"
					aria-label="Seek"
					aria-valuemin="0"
					aria-valuemax={Math.round(duration)}
					aria-valuenow="0"
				>
					<div class="tts-track">
						<div class="tts-mini-fill tts-fill" />
					</div>
				</div>
				<span class="tts-mini-time">
					<span class="tts-mini-elapsed">0:00</span>
					<span class="tts-sep"> / </span>
					<span class="tts-total">{minutes} min</span>
				</span>
				<button class="tts-mini-rate tts-rate" type="button" aria-label="Playback speed">
					1×
				</button>
				<button class="tts-mini-reset" type="button" aria-label="Reset to start">
					<svg class="tts-icon-reset" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z" />
					</svg>
				</button>
			</div>
		</div>
	)
}

<style>
	.tts {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-block: 1rem 1.75rem;
		padding: 0.6rem 0.85rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		background: var(--sl-color-black);
	}

	.tts-play {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		border-radius: 50%;
		cursor: pointer;
		color: var(--sl-color-black);
		background: var(--sl-color-text-accent);
		transition: opacity 0.15s ease;
	}
	.tts-play:hover {
		opacity: 0.85;
	}
	.tts-play svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: currentColor;
	}
	/* Only one of the two glyphs is ever shown. */
	.tts-icon-pause,
	.tts[data-playing] .tts-icon-play {
		display: none;
	}
	.tts[data-playing] .tts-icon-pause {
		display: block;
	}

	.tts-body {
		flex: 1;
		min-width: 0;
	}

	.tts-scrub {
		padding-block: 0.4rem;
		cursor: pointer;
	}
	.tts-track {
		height: 0.25rem;
		border-radius: 999px;
		background: var(--sl-color-gray-5);
		overflow: hidden;
	}
	.tts-fill {
		height: 100%;
		width: 0;
		border-radius: 999px;
		background: var(--sl-color-text-accent);
	}

	.tts-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 0.15rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.tts-controls {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.tts-rate {
		border: 0;
		padding: 0;
		font: inherit;
		color: var(--sl-color-gray-2);
		background: none;
		cursor: pointer;
	}
	.tts-rate:hover {
		color: var(--sl-color-text-accent);
	}
	.tts-reset {
		display: grid;
		place-items: center;
		border: 0;
		padding: 0;
		font: inherit;
		color: var(--sl-color-gray-2);
		background: none;
		cursor: pointer;
	}
	.tts-reset:hover {
		color: var(--sl-color-text-accent);
	}
	.tts-icon-reset {
		width: 0.95rem;
		height: 0.95rem;
		fill: currentColor;
	}
	.tts-chain {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		cursor: pointer;
		user-select: none;
	}
	.tts-chain input {
		accent-color: var(--sl-color-text-accent);
	}

	@media (max-width: 30rem) {
		.tts-chain span {
			display: none;
		}
	}

	/* The mini-player: a compact stand-in shown once the full player has
	   scrolled up under the sticky navbar, so playback controls stay
	   reachable without the section title (already visible, highlighted, in
	   the sidebar) taking up width. Hidden by default; JS toggles
	   `data-visible` once the boundary below the full player passes under
	   the navbar. */
	.tts-mini {
		display: none;
		position: fixed;
		top: var(--sl-nav-height);
		left: 0;
		right: 0;
		z-index: 10;
		align-items: center;
		gap: 0.6rem;
		padding: 0.35rem 1rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-black);
	}
	.tts-mini[data-visible] {
		display: flex;
	}
	.tts-mini-play {
		flex: none;
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border: 0;
		border-radius: 50%;
		cursor: pointer;
		color: var(--sl-color-black);
		background: var(--sl-color-text-accent);
	}
	.tts-mini-play svg {
		width: 0.85rem;
		height: 0.85rem;
		fill: currentColor;
	}
	.tts-mini-scrub {
		flex: 1;
		min-width: 0;
		padding-block: 0.4rem;
		cursor: pointer;
	}
	.tts-mini-time {
		flex: none;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		white-space: nowrap;
	}
	.tts-mini-rate,
	.tts-mini-reset {
		flex: none;
	}
	.tts-mini-reset {
		display: grid;
		place-items: center;
	}

	@media (max-width: 30rem) {
		.tts-mini-time .tts-total,
		.tts-mini-time .tts-sep {
			display: none;
		}
	}
</style>

<style is:global>
	/* The highlight the player moves through the page. Deliberately low
	   contrast — this sits under prose that is already being read, and a
	   saturated band is exhausting over four hours. */
	.sl-markdown-content [data-tts] {
		border-radius: 0.2rem;
		transition: background-color 0.2s ease;
	}
	.sl-markdown-content [data-tts].tts-active {
		background: color-mix(in srgb, var(--sl-color-text-accent) 18%, transparent);
	}
	/* Seeking by clicking a sentence is only offered once audio is loaded. */
	.tts-seekable .sl-markdown-content [data-tts]:hover {
		cursor: pointer;
		background: color-mix(in srgb, var(--sl-color-text-accent) 9%, transparent);
	}

	@media (prefers-reduced-motion: reduce) {
		.sl-markdown-content [data-tts] {
			transition: none;
		}
	}
</style>

<script>
	interface Timing {
		duration: number;
		sentences: Array<{ i: number; start: number; end: number }>;
	}

	const RATES = [0.9, 1, 1.15, 1.3, 1.5, 1.75];

	function setup(root: HTMLElement) {
		const key = root.dataset.key!;
		const next = root.dataset.next || '';
		const audio = root.querySelector<HTMLAudioElement>('.tts-audio')!;
		const playButton = root.querySelector<HTMLButtonElement>('.tts-play')!;
		const rateButton = root.querySelector<HTMLButtonElement>('.tts-rate')!;
		const resetButton = root.querySelector<HTMLButtonElement>('.tts-reset')!;
		const chain = root.querySelector<HTMLInputElement>('.tts-chain input')!;
		const scrub = root.querySelector<HTMLElement>('.tts-scrub')!;
		const fill = root.querySelector<HTMLElement>('.tts-fill')!;
		const elapsed = root.querySelector<HTMLElement>('.tts-elapsed')!;

		// The mini-player: a compact mirror of the controls above, shown once
		// the full player scrolls up under the sticky navbar. It has no state
		// of its own — every control just proxies the equivalent full-player
		// control, so there is exactly one source of truth for playback.
		const mini = root.querySelector<HTMLElement>('.tts-mini')!;
		// `position: fixed` only escapes the page layout if nothing between
		// here and <body> establishes its own containing block (a `transform`
		// or similar). Starlight's content pane does, so move the mini-player
		// out to <body> rather than depend on that never changing. Starlight's
		// client-side routing means `mount()` can run again without a full
		// document reload, so drop any mini-player stranded there by a
		// previous page before adding this one.
		document.querySelectorAll('body > .tts-mini').forEach((stray) => stray.remove());
		document.body.appendChild(mini);
		// Queried from `mini`, not `root`: `mini` no longer lives under `root`
		// after the move above, so `root.querySelector('.tts-mini-*')` would
		// come back null.
		const miniPlayButton = mini.querySelector<HTMLButtonElement>('.tts-mini-play')!;
		const miniRateButton = mini.querySelector<HTMLButtonElement>('.tts-mini-rate')!;
		const miniResetButton = mini.querySelector<HTMLButtonElement>('.tts-mini-reset')!;
		const miniScrub = mini.querySelector<HTMLElement>('.tts-mini-scrub')!;
		const miniFill = mini.querySelector<HTMLElement>('.tts-mini-fill')!;
		const miniElapsed = mini.querySelector<HTMLElement>('.tts-mini-elapsed')!;

		const posKey = `tts:pos:${key}`;
		let timing: Timing | null = null;
		let spans: HTMLElement[] = [];
		let active = -1;
		let raf = 0;
		// Bumped by reset() to invalidate any in-flight async seek (scrub drag,
		// sentence click) that might otherwise land after the reset and silently
		// resurrect a position.
		let opGen = 0;
		// Set for the duration of reset()'s own `pause()` call, so the `pause`
		// listener below doesn't re-save the position it just cleared.
		let suppressSave = false;

		const clock = (s: number) =>
			`${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

		// Restore the saved rate immediately; it applies before any audio loads.
		const savedRate = Number(localStorage.getItem('tts:rate') ?? '1');
		audio.playbackRate = RATES.includes(savedRate) ? savedRate : 1;
		rateButton.textContent = `${audio.playbackRate}×`;
		miniRateButton.textContent = `${audio.playbackRate}×`;
		chain.checked = localStorage.getItem('tts:chain') !== '0';

		async function loadTiming() {
			if (timing) return timing;
			const response = await fetch(`/audio/${key}.json`);
			if (!response.ok) throw new Error(`no timing for ${key}`);
			timing = (await response.json()) as Timing;
			spans = timing.sentences.map(
				(s) => document.querySelector<HTMLElement>(`[data-tts="${s.i}"]`)!,
			);
			document.body.classList.add('tts-seekable');
			return timing;
		}

		function highlight(time: number) {
			if (!timing) return;
			const list = timing.sentences;
			// Binary search for the sentence containing `time`.
			let lo = 0;
			let hi = list.length - 1;
			let found = -1;
			while (lo <= hi) {
				const mid = (lo + hi) >> 1;
				if (time < list[mid]!.start) hi = mid - 1;
				else if (time > list[mid]!.end) lo = mid + 1;
				else {
					found = mid;
					break;
				}
			}
			// Between two sentences: hold the previous one rather than flicker.
			if (found === -1) found = Math.max(0, hi);
			if (found === active) return;

			spans[active]?.classList.remove('tts-active');
			active = found;
			const span = spans[active];
			if (!span) return;
			span.classList.add('tts-active');

			const box = span.getBoundingClientRect();
			if (box.top < 80 || box.bottom > window.innerHeight - 80) {
				span.scrollIntoView({ block: 'center', behavior: 'smooth' });
			}
		}

		function tick() {
			const percent = `${(audio.currentTime / (audio.duration || 1)) * 100}%`;
			const time = clock(audio.currentTime);
			const rounded = String(Math.round(audio.currentTime));
			fill.style.width = percent;
			elapsed.textContent = time;
			scrub.setAttribute('aria-valuenow', rounded);
			miniFill.style.width = percent;
			miniElapsed.textContent = time;
			miniScrub.setAttribute('aria-valuenow', rounded);
			highlight(audio.currentTime);
			raf = requestAnimationFrame(tick);
		}

		/** `currentTime` is only settable once metadata has arrived. */
		function ready() {
			if (audio.readyState >= 1) return Promise.resolve();
			audio.load();
			return new Promise<void>((resolve) => {
				audio.addEventListener('loadedmetadata', () => resolve(), { once: true });
				audio.addEventListener('error', () => resolve(), { once: true });
			});
		}

		async function play() {
			const gen = opGen;
			await loadTiming();
			await ready();
			if (gen !== opGen) return; // reset happened while this was in flight
			const saved = Number(localStorage.getItem(posKey) ?? '0');
			// Only resume if the saved position is not effectively the end.
			if (saved > 1 && audio.currentTime < 1 && saved < (audio.duration || Infinity) - 2) {
				audio.currentTime = saved;
			}
			await audio.play();
		}

		playButton.addEventListener('click', () => {
			if (audio.paused) play().catch(() => {});
			else audio.pause();
		});
		// The mini-player has no state of its own; every control proxies the
		// equivalent full-player control.
		miniPlayButton.addEventListener('click', () => playButton.click());
		miniRateButton.addEventListener('click', () => rateButton.click());
		miniResetButton.addEventListener('click', () => resetButton.click());

		audio.addEventListener('play', () => {
			root.dataset.playing = '';
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(tick);
		});

		audio.addEventListener('pause', () => {
			delete root.dataset.playing;
			cancelAnimationFrame(raf);
			if (suppressSave) suppressSave = false;
			else localStorage.setItem(posKey, String(audio.currentTime));
		});

		audio.addEventListener('ended', () => {
			localStorage.removeItem(posKey);
			spans[active]?.classList.remove('tts-active');
			if (chain.checked && next) {
				sessionStorage.setItem('tts:autoplay', '1');
				location.href = next;
			}
		});

		// Keep the resume point fresh without writing on every frame.
		setInterval(() => {
			if (!audio.paused) localStorage.setItem(posKey, String(audio.currentTime));
		}, 5000);
		addEventListener('pagehide', () => {
			if (audio.currentTime > 0) localStorage.setItem(posKey, String(audio.currentTime));
		});

		rateButton.addEventListener('click', () => {
			const rate = RATES[(RATES.indexOf(audio.playbackRate) + 1) % RATES.length]!;
			audio.playbackRate = rate;
			rateButton.textContent = `${rate}×`;
			miniRateButton.textContent = `${rate}×`;
			localStorage.setItem('tts:rate', String(rate));
		});

		resetButton.addEventListener('click', () => {
			opGen++; // invalidate any pending seekTo()/sentence-click resolution
			// audio.pause() only fires a `pause` event (and thus only needs
			// suppressing) if playback was actually in progress.
			if (!audio.paused) suppressSave = true;
			audio.pause();
			delete root.dataset.playing; // pause event is async; update the icon now
			cancelAnimationFrame(raf);
			if (audio.readyState >= 1) audio.currentTime = 0;
			localStorage.removeItem(posKey);
			fill.style.width = '0%';
			elapsed.textContent = '0:00';
			scrub.setAttribute('aria-valuenow', '0');
			miniFill.style.width = '0%';
			miniElapsed.textContent = '0:00';
			miniScrub.setAttribute('aria-valuenow', '0');
			spans[active]?.classList.remove('tts-active');
			active = -1;
		});

		chain.addEventListener('change', () =>
			localStorage.setItem('tts:chain', chain.checked ? '1' : '0'),
		);

		const seekTo = (target: HTMLElement) => (event: PointerEvent) => {
			const gen = opGen;
			const box = target.getBoundingClientRect();
			const ratio = Math.min(1, Math.max(0, (event.clientX - box.left) / box.width));
			loadTiming()
				.then(ready)
				.then(() => {
					if (gen !== opGen) return; // reset happened while this was in flight
					audio.currentTime = ratio * (audio.duration || timing!.duration);
					highlight(audio.currentTime);
				})
				.catch(() => {});
		};
		const seekByArrowKey = (event: KeyboardEvent) => {
			if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
			event.preventDefault();
			audio.currentTime += event.key === 'ArrowRight' ? 10 : -10;
		};
		scrub.addEventListener('pointerdown', seekTo(scrub));
		scrub.addEventListener('keydown', seekByArrowKey);
		miniScrub.addEventListener('pointerdown', seekTo(miniScrub));
		miniScrub.addEventListener('keydown', seekByArrowKey);

		// Show the mini-player once the full player (whose bottom edge is the
		// "line below" it, via its border) has scrolled up under the sticky
		// navbar; hide it again once that edge is back on screen.
		function updateMiniVisibility() {
			// Starlight's client-side routing swaps in a fresh `[data-tts-player]`
			// per page and re-runs setup() without a full reload, so a `window`
			// listener from a page the visitor has already left behind would
			// otherwise never be removed. Self-unregister once `root` is gone
			// rather than tracking every page's listeners for manual teardown.
			if (!root.isConnected) {
				removeEventListener('scroll', updateMiniVisibility);
				removeEventListener('resize', updateMiniVisibility);
				return;
			}
			// Re-queried rather than cached: `header.header` may not exist yet
			// at setup() time on some navigations, and a cached `null` would
			// wedge `navHeight` at 0 for the rest of the page's lifetime.
			const header = document.querySelector<HTMLElement>('header.header');
			const navHeight = header?.getBoundingClientRect().height ?? 0;
			mini.toggleAttribute('data-visible', root.getBoundingClientRect().bottom < navHeight);
		}
		addEventListener('scroll', updateMiniVisibility, { passive: true });
		addEventListener('resize', updateMiniVisibility);
		updateMiniVisibility();

		// Click a sentence to jump to it. Ignored while text is being selected,
		// so this does not fight with copying a quote.
		document.querySelector('.sl-markdown-content')?.addEventListener('click', (event) => {
			if (!timing) return;
			if (window.getSelection()?.toString()) return;
			const span = (event.target as HTMLElement).closest<HTMLElement>('[data-tts]');
			if (!span) return;
			const entry = timing.sentences.find((s) => String(s.i) === span.dataset.tts);
			if (!entry) return;
			const gen = opGen;
			ready().then(() => {
				if (gen !== opGen) return; // reset happened while this was in flight
				audio.currentTime = entry.start;
				highlight(entry.start);
				if (audio.paused) audio.play().catch(() => {});
			});
		});

		// Arriving from a previous page's auto-advance.
		if (sessionStorage.getItem('tts:autoplay') === '1') {
			sessionStorage.removeItem('tts:autoplay');
			localStorage.removeItem(posKey);
			play().catch(() => {
				// Autoplay was refused — leave the control ready for a click.
			});
		}
	}

	const mount = () => {
		const root = document.querySelector<HTMLElement>('[data-tts-player]');
		if (root && !root.dataset.ready) {
			root.dataset.ready = '1';
			setup(root);
		}
	};

	mount();
	document.addEventListener('astro:page-load', mount);
</script>
